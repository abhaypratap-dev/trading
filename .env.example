# Copy to .env and edit.  (scripts/setup_mac.sh does this for you)

# Dashboard / API admin token - change this
ADMIN_TOKEN=change-me
POSTGRES_PASSWORD=yonexis

# ---- Local LLM (any OpenAI-compatible server) ----
# Native Ollama on the Mac (recommended, uses the Apple GPU):
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
# 7b runs on 16 GB RAM; use qwen2.5-coder:14b or :32b if you have 32-64 GB for better code.
LLM_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT=300
# Hosted alternative (better code generation), e.g. Azure OpenAI:
# LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
# LLM_API_KEY=<key>

# ---- Live feed ----
# upstox = Upstox live WebSocket feed (needs the UPSTOX_* keys below + daily login on the Data tab)
# simulated = replays synthetic sessions (works any time) | yahoo = delayed public data | kite = Zerodha live
LIVE_CONNECTOR=upstox
LIVE_INTERVAL=5m
LIVE_REPLAY_SPEED=2
WATCHLIST=RELIANCE,HDFCBANK,ICICIBANK,SBIN,INFY,TCS,LT,AXISBANK,KOTAKBANK,BHARTIARTL,ITC,TATAMOTORS,HINDUNILVR,SUNPHARMA,BAJFINANCE,ADANIENT,TATAPOWER,MARUTI,HCLTECH,WIPRO

# ---- Trading ----  (paper until you deliberately switch)
TRADING_MODE=paper
# BROKER: paper | upstox | kite
BROKER=paper
# Upstox app (https://account.upstox.com/developer/apps): set its Redirect URL to exactly UPSTOX_REDIRECT_URI
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/upstox/callback
UPSTOX_FEED_MODE=full
# BROKER=upstox + TRADING_MODE=live sends real orders through Upstox
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# ---- Risk ----
MAX_DAILY_LOSS=10000
MAX_OPEN_POSITIONS=5
CAPITAL_PER_TRADE=100000
MAX_ORDERS_PER_SEC=5
NO_ENTRY_AFTER=15:00
MIN_SIGNAL_SCORE=0.0

SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_MB=2048

# Host ports (change if something else already uses them)
DB_HOST_PORT=55432
